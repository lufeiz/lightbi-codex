APP_ENV=production
MYSQL_DATABASE=lightbi
MYSQL_USER=lightbi
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DSN=lightbi:replace-with-strong-db-password@tcp(mysql:3306)/lightbi?charset=utf8mb4&parseTime=True&loc=Local

JWT_ACCESS_SECRET=replace-with-at-least-32-random-chars-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-chars-refresh
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
RUN_AUTO_MIGRATE=false
RUN_SEED_DEFAULTS=false
REGISTER_MODE=disabled
REGISTER_CODE=

DATA_SOURCE_CREDENTIAL_KEY=replace-with-at-least-32-random-chars-data-source-key
DATA_SOURCE_ALLOWED_HOSTS=
DATA_SOURCE_BLOCK_PRIVATE_NETWORKS=true
DATASET_QUERY_SCHEDULER=false
DATASET_QUERY_MAX_CONCURRENT=8
DATASET_QUERY_LOG_RETENTION_DAYS=30
