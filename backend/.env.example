APP_ENV=development
APP_ADDR=:8080
MYSQL_DSN=lightbi:lightbi@tcp(127.0.0.1:3306)/lightbi?charset=utf8mb4&parseTime=True&loc=Local
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
SEED_ADMIN_PASSWORD=LightBI@123456
RUN_AUTO_MIGRATE=true
RUN_SEED_DEFAULTS=true
REGISTER_MODE=invite
REGISTER_CODE=replace-with-register-code
DATA_SOURCE_CREDENTIAL_KEY=replace-with-a-long-data-source-credential-key
DATASET_QUERY_SCHEDULER=false
